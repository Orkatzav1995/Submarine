# STM32CubeIDE build output (regenerated by building the Embeded project;
# .cproject/.project/.mxproject/.settings/Embeded.ioc/Embeded.launch are
# the actual project files and are kept)
Embeded/Debug/
Embeded/Release/

# Compiled C/C++ build artifacts (test executables, object/dependency files)
*.exe
*.o
*.obj
*.d
*.su
*.cyclo
*.map
*.list

# CentralComputer build output (cc_main.exe and any intermediates)
CentralComputer/build/

# Runtime-generated SQLite database (created by cc_main.exe when actually
# run against a real file; not a source fixture)
/central_computer.db

# Claude Code local session/tool data - not part of the Submarine project
.claude/

# Editor / OS cruft
.vscode/
.vs/
*.swp
Thumbs.db
.DS_Store
